{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Night map of Brisbane: busy hexagons coloured by how many of the eight kinds of event they host. Updated for high-contrast white labels, clearer map boundaries and readable legends.",
  "config": {
    "view": {
      "stroke": null,
      "fill": "#101c34"
    },
    "font": "Source Serif 4",
    "axis": {
      "labelFont": "Source Serif 4",
      "titleFont": "Source Serif 4",
      "domain": false,
      "tickSize": 0,
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#ffffff",
      "titleColor": "#ffffff",
      "gridColor": "#405477",
      "labelPadding": 6,
      "titlePadding": 10
    },
    "legend": {
      "labelFont": "Source Serif 4",
      "titleFont": "Source Serif 4",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#ffffff",
      "titleColor": "#ffffff",
      "titleLimit": 320
    },
    "text": {
      "font": "Source Serif 4",
      "color": "#ffffff"
    }
  },
  "usermeta": {
    "map": true,
    "w0": 560,
    "h0": 470,
    "scale0": 72498
  },
  "width": 560,
  "height": 470,
  "projection": {
    "type": "mercator",
    "center": [
      153.055,
      -27.47
    ],
    "scale": 72498
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "a": 1
          }
        ]
      },
      "mark": {
        "type": "rect",
        "x": 0,
        "y": 0,
        "x2": "width",
        "y2": "height",
        "fill": "#0e1a33",
        "stroke": null
      }
    },
    {
      "data": {
        "url": "states.geojson",
        "format": {
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#24395f",
        "stroke": "#5876a8",
        "strokeWidth": 1.25
      }
    },
    {
      "data": {
        "url": "hexgrid.json",
        "format": {
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.n >= 10"
        }
      ],
      "params": [
        {
          "name": "hov",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "strokeJoin": "round",
        "opacity": 0.95
      },
      "encoding": {
        "stroke": {
          "condition": {
            "param": "hov",
            "empty": false,
            "value": "#ffffff"
          },
          "value": "#10233f"
        },
        "strokeWidth": {
          "condition": {
            "param": "hov",
            "empty": false,
            "value": 2.5
          },
          "value": 1.05
        },
        "color": {
          "field": "properties.types",
          "type": "quantitative",
          "scale": {
            "domain": [
              1,
              2,
              3,
              4,
              6
            ],
            "range": [
              "#32164b",
              "#8e2474",
              "#e13c79",
              "#ff9568",
              "#ffe08a"
            ],
            "clamp": true
          },
          "legend": {
            "title": "Kinds of event (of 8)",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 220,
            "gradientThickness": 12,
            "values": [
              1,
              2,
              3,
              4,
              5,
              6
            ],
            "labelColor": "#ffffff",
            "titleColor": "#ffffff",
            "labelFontSize": 12,
            "titleFontSize": 12
          }
        },
        "tooltip": [
          {
            "field": "properties.types",
            "type": "quantitative",
            "title": "Kinds of event"
          },
          {
            "field": "properties.n",
            "type": "quantitative",
            "title": "Events"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "name": "CBD",
            "lat": -27.4698,
            "lon": 153.0251
          },
          {
            "name": "Chermside",
            "lat": -27.386,
            "lon": 153.034
          },
          {
            "name": "Indooroopilly",
            "lat": -27.5,
            "lon": 152.973
          },
          {
            "name": "Carindale",
            "lat": -27.505,
            "lon": 153.1
          },
          {
            "name": "Sunnybank",
            "lat": -27.576,
            "lon": 153.058
          }
        ]
      },
      "encoding": {
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        }
      },
      "layer": [
        {
          "mark": {
            "type": "point",
            "shape": "circle",
            "size": 42,
            "filled": true,
            "color": "#ffffff",
            "stroke": "#071326",
            "strokeWidth": 1.6
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 13,
            "fontWeight": 700,
            "align": "left",
            "dx": 9,
            "dy": -9,
            "color": "#ffffff",
            "stroke": "#08162e",
            "strokeWidth": 3.5,
            "strokeJoin": "round",
            "strokeOpacity": 1,
            "limit": 220
          },
          "encoding": {
            "text": {
              "field": "name",
              "type": "nominal"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 13,
            "fontWeight": 700,
            "align": "left",
            "dx": 9,
            "dy": -9,
            "color": "#ffffff",
            "stroke": "#08162e",
            "strokeWidth": 3.5,
            "strokeJoin": "round",
            "strokeOpacity": 1,
            "limit": 220
          },
          "encoding": {
            "text": {
              "field": "name",
              "type": "nominal"
            }
          }
        }
      ]
    }
  ]
}
